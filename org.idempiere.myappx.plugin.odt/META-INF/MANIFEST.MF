Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: MyAppx Plugin : ObjectData Tool
Bundle-SymbolicName: org.idempiere.myappx.plugin.odt;singleton:=true
Bundle-Version: 14.0.0.qualifier
Bundle-Activator: org.idempiere.myappx.plugin.odt.Activator
Bundle-Vendor: Ken Longnan <ken.longnan@gmail.com>
Bundle-RequiredExecutionEnvironment: JavaSE-17
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version>=17))"
Require-Bundle: org.adempiere.base;bundle-version="0.0.0",
 org.adempiere.base.process;bundle-version="0.0.0",
 org.adempiere.plugin.utils;bundle-version="0.0.0"
Import-Package: org.osgi.framework;version="1.6.0",
 org.osgi.service.event;version="1.3.0",
 org.xml.sax,
 javax.xml.parsers,
 javax.xml.transform,
 javax.xml.transform.dom,
 javax.xml.transform.stream
Export-Package: org.idempiere.myappx.plugin.odt,
 org.idempiere.myappx.plugin.odt.model,
 org.idempiere.myappx.plugin.odt.process
Bundle-ClassPath: .
Service-Component: OSGI-INF/*.xml
Bundle-ActivationPolicy: lazy
Automatic-Module-Name: org.idempiere.myappx.plugin.odt
